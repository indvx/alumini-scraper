# Model + Migration + Factory
php artisan make:model Product -mf

# API Controller
php artisan make:controller Api/ProductController --api --model=Product

# API Form Requests
php artisan make:request Api/RfpSearchRequest

# API Resource
php artisan make:resource Api/RfpSearchResource

# API Policy
php artisan make:policy Api/ProductPolicy --model=Product

# Seeder
php artisan make:seeder ProductSeeder

# Job
php artisan make:job Api/ProcessProduct

# Event
php artisan make:event Api/ProductCreated

# Listener
php artisan make:listener Api/SendProductNotification

# Artisan Command
php artisan make:command Api/ProcessProducts

# Middleware
php artisan make:middleware Api/AuthenticateApi

# Mail
php artisan make:mail Api/ProductCreatedMail

# Notification
php artisan make:notification Api/ProductNotification

# Generate Swagger
php artisan l5-swagger:generate

# Clear Laravel cache
php artisan optimize:clear

# Run migrations
php artisan migrate

# Run seeders
php artisan db:seed

# View API routes
php artisan route:list --path=api
